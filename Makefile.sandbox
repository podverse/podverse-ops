.PHONY: sandbox_validate_init
sandbox_validate_init: config/podverse-sandbox-db.env config/podverse-sandbox-mq.env config/podverse-sandbox-workers.env config/podverse-sandbox-api.env config/podverse-sandbox-web.env

config/podverse-sandbox-db.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-sandbox-mq.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-sandbox-workers.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-sandbox-api.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-sandbox-web.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

.PHONY: sandbox_db_up
sandbox_db_up: config/podverse-sandbox-db.env
	docker compose -f docker-compose/sandbox/db/docker-compose.yml up podverse_sandbox_db -d

.PHONY: sandbox_db_down
sandbox_db_down:
	docker compose -f docker-compose/sandbox/db/docker-compose.yml down --remove-orphans --rmi all

.PHONY: sandbox_db_init
sandbox_db_init: config/podverse-sandbox-db.env
	@echo "Creating read/read_write roles (idempotent)..."
	@set -a; . config/podverse-sandbox-db.env; set +a; \
	docker compose -f docker-compose/sandbox/db/docker-compose.yml exec podverse_sandbox_db bash -c "POSTGRES_READ_PASSWORD=$$POSTGRES_READ_PASSWORD POSTGRES_READ_WRITE_PASSWORD=$$POSTGRES_READ_WRITE_PASSWORD /opt/database/init-scripts/01-create-users.sh"
	docker exec -i podverse_sandbox_db psql -U postgres -d postgres -f /opt/database/combined/init_database.sql

.PHONY: sandbox_mq_up
sandbox_mq_up: config/podverse-sandbox-mq.env
	docker compose -f docker-compose/sandbox/mq/docker-compose.yml up podverse_sandbox_mq -d
	@./scripts/mq/provision_queues.sh podverse_sandbox_mq config/podverse-sandbox-mq.env

.PHONY: sandbox_mq_down
sandbox_mq_down:
	docker compose -f docker-compose/sandbox/mq/docker-compose.yml down --remove-orphans --rmi all

.PHONY: sandbox_workers_pull
sandbox_workers_pull: config/podverse-sandbox-workers.env
	docker compose -f docker-compose/sandbox/workers/docker-compose.yml pull podverse_sandbox_workers

.PHONY: sandbox_workers_down
sandbox_workers_down:
	docker compose -f docker-compose/sandbox/workers/docker-compose.yml down --remove-orphans --rmi all

.PHONY: sandbox_api_up
sandbox_api_up: config/podverse-sandbox-api.env
	docker compose -f docker-compose/sandbox/api/docker-compose.yml up podverse_sandbox_api -d

.PHONY: sandbox_api_down
sandbox_api_down:
	docker compose -f docker-compose/sandbox/api/docker-compose.yml down --remove-orphans --rmi all

.PHONY: sandbox_web_up
sandbox_web_up: config/podverse-sandbox-web.env
	docker compose -f docker-compose/sandbox/web/docker-compose.yml up podverse_sandbox_web -d

.PHONY: sandbox_web_down
sandbox_web_down:
	docker compose -f docker-compose/sandbox/web/docker-compose.yml down --remove-orphans --rmi all

.PHONY: sandbox_all_down
sandbox_all_down:
	-$(MAKE) sandbox_web_down
	-$(MAKE) sandbox_api_down
	-$(MAKE) sandbox_workers_down
	-$(MAKE) sandbox_mq_down
	-$(MAKE) sandbox_db_down
