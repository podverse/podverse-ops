networks:
  podverse_sandbox_network:
    external: true

volumes:
  podverse_sandbox_workers_data:

services:
  
  podverse_sandbox_workers:
    image: ghcr.io/podverse/podverse-workers/podverse-workers:REPLACE_WITH_WORKERS_VERSION
    container_name: podverse_sandbox_workers
    env_file:
      - ../../../config/podverse-sandbox-workers.env
    networks:
      - podverse_sandbox_network
    volumes:
      - ../../../config/firebase/firebase-key.json:/app/config/firebase-key.json:ro
      - podverse_sandbox_workers_data:/data
    logging:
      driver: "syslog"
      options:
        tag: "{{.ImageName}}/{{.Name}}/{{.ID}}"