.PHONY: local_validate_init
local_validate_init: config/podverse-local-db.env config/podverse-local-mq.env config/podverse-local-workers.env config/podverse-local-api.env

config/podverse-local-db.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-local-mq.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-local-workers.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

config/podverse-local-api.env:
	@echo "Missing: $@"
	@echo "Copying from example file"
	cp ./$@.example ./$@

.PHONY: local_db_up
local_db_up: config/podverse-local-db.env
	docker compose -f docker-compose/local/db/docker-compose.yml up podverse_local_db -d

.PHONY: local_db_stop
local_db_stop:
	docker compose -f docker-compose/local/db/docker-compose.yml down --remove-orphans

.PHONY: local_db_down
local_db_down:
	docker compose -f docker-compose/local/db/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_db_reset
local_db_reset:
	@echo "Dropping and recreating public schema..."
	docker exec -i podverse_local_db psql -U postgres -d postgres -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO postgres; GRANT ALL ON SCHEMA public TO public;"

.PHONY: local_db_init
local_db_init: config/podverse-local-db.env
	@echo "Creating read/read_write roles (idempotent)..."
	@set -a; . config/podverse-local-db.env; set +a; \
	docker compose -f docker-compose/local/db/docker-compose.yml exec podverse_local_db bash -c "POSTGRES_READ_PASSWORD=$$POSTGRES_READ_PASSWORD POSTGRES_READ_WRITE_PASSWORD=$$POSTGRES_READ_WRITE_PASSWORD /opt/database/init-scripts/01-create-users.sh"
	docker exec -i podverse_local_db psql -U postgres -d postgres -f /opt/database/combined/init_database.sql

.PHONY: local_db_seed_dev
local_db_seed_dev:
	@echo "Seeding local dev account (localdev@podverse.fm / Test!1Aa)..."
	docker exec -i podverse_local_db psql -U postgres -d postgres -f /opt/database/seed-scripts/local-dev-account.sql

.PHONY: local_db_reinit
local_db_reinit: local_db_reset local_db_init local_db_seed_dev
	@echo "Database re-initialized with local dev account"

.PHONY: local_mq_up
local_mq_up: config/podverse-local-mq.env
	docker compose -f docker-compose/local/mq/docker-compose.yml up podverse_local_mq -d
	@./scripts/mq/provision_queues.sh podverse_local_mq config/podverse-local-mq.env

.PHONY: local_mq_down
local_mq_down:
	docker compose -f docker-compose/local/mq/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_workers_pull
local_workers_pull: config/podverse-local-workers.env
	docker compose -f docker-compose/local/workers/docker-compose.yml pull podverse_local_workers

.PHONY: local_workers_down
local_workers_down:
	docker compose -f docker-compose/local/workers/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_api_up
local_api_up: config/podverse-local-api.env
	docker compose -f docker-compose/local/api/docker-compose.yml up podverse_local_api -d

.PHONY: local_api_down
local_api_down:
	docker compose -f docker-compose/local/api/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_web_up
local_web_up:
	docker compose -f docker-compose/local/web/docker-compose.yml up podverse_local_web -d

.PHONY: local_web_down
local_web_down:
	docker compose -f docker-compose/local/web/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_keyvaldb_up
local_keyvaldb_up: config/podverse-local-keyvaldb.env
	docker compose -f docker-compose/local/keyvaldb/docker-compose.yml up podverse_local_keyvaldb -d
	docker compose -f docker-compose/local/keyvaldb/docker-compose.yml up podverse_local_keyvaldb_gui -d

.PHONY: local_keyvaldb_down
local_keyvaldb_down:
	docker compose -f docker-compose/local/keyvaldb/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_all_down
local_all_down:
	-$(MAKE) local_keyvaldb_down
	-$(MAKE) local_web_down
	-$(MAKE) local_api_down
	-$(MAKE) local_workers_down
	-$(MAKE) local_mq_down
	-$(MAKE) local_db_down
	-$(MAKE) local_management_web_down
	-$(MAKE) local_management_api_down
	-$(MAKE) local_management_db_down

# ==========================================
# Management System
# ==========================================

# Management Database
.PHONY: local_management_db_up
local_management_db_up: config/podverse-local-management-db.env
	docker compose -f docker-compose/local/management-db/docker-compose.yml up podverse_local_management_db -d

.PHONY: local_management_db_stop
local_management_db_stop:
	docker compose -f docker-compose/local/management-db/docker-compose.yml down --remove-orphans

.PHONY: local_management_db_down
local_management_db_down:
	docker compose -f docker-compose/local/management-db/docker-compose.yml down --remove-orphans --rmi all

.PHONY: local_management_db_reset
local_management_db_reset:
	@echo "Dropping and recreating public schema..."
	docker exec -i podverse_local_management_db psql -U postgres -d postgres -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO postgres; GRANT ALL ON SCHEMA public TO public;"

.PHONY: local_management_db_init
local_management_db_init: config/podverse-local-management-db.env
	@echo "Validating required environment variables..."
	@set -a; . config/podverse-local-management-db.env; set +a; \
	: "$${SUPERUSER_EMAIL:?Missing SUPERUSER_EMAIL}" \
	: "$${SUPERUSER_PASSWORD:?Missing SUPERUSER_PASSWORD}"
	@echo "Creating read/read_write roles (idempotent)..."
	@set -a; . config/podverse-local-management-db.env; set +a; \
	docker compose -f docker-compose/local/management-db/docker-compose.yml exec podverse_local_management_db bash -c "POSTGRES_READ_PASSWORD=$$POSTGRES_READ_PASSWORD POSTGRES_READ_WRITE_PASSWORD=$$POSTGRES_READ_WRITE_PASSWORD /opt/database/management/init-scripts/01-create-users.sh"
	docker exec -i podverse_local_management_db psql -U postgres -d postgres -f /opt/database/management/init_management_database.sql
	@echo "Creating superuser account..."
	@set -a; . config/podverse-local-management-db.env; set +a; \
	./scripts/management/create-superuser.sh

.PHONY: local_management_db_seed_dev
local_management_db_seed_dev:
	@echo "Note: Seed script removed - superuser is created during init"

.PHONY: local_management_db_reinit
local_management_db_reinit: local_management_db_reset local_management_db_init
	@echo "Management database re-initialized with superuser account"

# Management API
.PHONY: local_management_api_up
local_management_api_up: config/podverse-local-management-api.env
	docker compose -f docker-compose/local/management-api/docker-compose.yml up podverse_local_management_api -d

.PHONY: local_management_api_down
local_management_api_down:
	docker compose -f docker-compose/local/management-api/docker-compose.yml down --remove-orphans --rmi all

# Management Web
.PHONY: local_management_web_up
local_management_web_up:
	docker compose -f docker-compose/local/management-web/docker-compose.yml up podverse_local_management_web -d

.PHONY: local_management_web_down
local_management_web_down:
	docker compose -f docker-compose/local/management-web/docker-compose.yml down --remove-orphans --rmi all