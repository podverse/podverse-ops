pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Stop Alpha KeyValDB') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops'
                    dir('/opt/podverse-ops') {
                        // Maps to 'make alpha_keyvaldb_down'
                        // We include 'set -ux' to match the XML's 'set -eux'
                        // (Jenkins sh defaults to -e automatically)
                        sh '''
                            set -ux
                            make alpha_keyvaldb_down
                        '''
                    }
                }
            }
        }
    }
}
