pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Clear Sandbox Cache') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops/docker-compose/sandbox/workers'
                    // CAUTION: This targets the sandbox environment, not alpha.
                    dir('/opt/podverse-ops/docker-compose/sandbox/workers') {
                        // Maps to the docker compose command.
                        // We use triple single-quotes to preserve 'set -eux' and strict shell syntax.
                        sh '''
                            set -eux
                            docker compose -f docker-compose.yml run --rm podverse_sandbox_workers npm run podcast_index_dead_feeds_delete_cache
                        '''
                    }
                }
            }
        }
    }
}