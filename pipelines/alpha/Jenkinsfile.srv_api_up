pipeline {
    // Maps to <assignedNode>pv-alpha-srv</assignedNode>
    agent {
        label 'pv-alpha-srv'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'IMAGE_VERSION', 
            defaultValue: 'alpha', 
            description: 'Specify the podverse_api alpha docker image version.'
        )
        
        choice(
            name: 'GHCR_IMAGE_PATH', 
            choices: ['podverse/podverse-api/podverse-api'], 
            description: 'The GHCR path the images are hosted at.'
        )

        // Maps to the CredentialsParameterDefinition.
        // Note: This parameter passes the Credential ID to the job, not the secret content itself.
        credentials(
            name: 'GHCR_REGISTRY_TOKEN', 
            defaultValue: 'ghcr_pat_read_only_packages', 
            credentialType: 'SecretText', 
            required: true, 
            description: 'Token for GHCR access'
        )
    }

    stages {
        stage('Prepare Configuration') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops/docker-compose/alpha/api'
                    dir('/opt/podverse-ops/docker-compose/alpha/api') {
                        // We use a multi-line shell script to preserve the logic from the XML
                        sh '''#!/bin/bash
                        set -euo pipefail

                        if [[ "${IMAGE_VERSION}" == "alpha" ]]; then
                            # Calls the external script to get the tag
                            API_VERSION=$(/opt/podverse-ops/scripts/ghcr/getLatestAlphaTag.sh)
                            
                            if [[ -z "${API_VERSION}" ]]; then
                                echo "ERROR: No alpha tag found from getLatestAlphaTag.sh" >&2
                                exit 1
                            fi
                        else
                            API_VERSION="${IMAGE_VERSION}"
                        fi

                        echo "Using API_VERSION=${API_VERSION}"

                        # Generates the actual docker-compose file from the template
                        sed "s/REPLACE_WITH_API_VERSION/${API_VERSION}/g" docker-compose.yml.template > docker-compose.yml
                        '''
                    }
                }
            }
        }

        stage('Start Alpha API') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops'
                    dir('/opt/podverse-ops') {
                        // Maps to 'make alpha_api_up'
                        sh 'make alpha_api_up'
                    }
                }
            }
        }
    }
}