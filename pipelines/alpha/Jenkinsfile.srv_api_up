pipeline {
    agent {
        label 'pv-alpha-srv'
    }

    parameters {
        string(name: 'IMAGE_VERSION', defaultValue: 'alpha', description: 'Specify the podverse_api alpha docker image version.')
        choice(name: 'GHCR_PATH', choices: ['podverse/podverse-api/podverse-api'], description: 'The GHCR path the images are hosted at.')
        credentials(name: 'GHCR_REGISTRY_TOKEN', credentialType: 'Secret text', required: true, defaultValue: 'The GHCR classic PAT for read only packages operations', description: 'Token used to authenticate to GHCR for read-only operations.')
    }

    stages {
        stage('Run Script') {
            steps {
                sh """#!/usr/bin/env bash
                    set -euo pipefail

                    pushd /opt/podverse-ops/docker-compose/alpha/api

                    if [[ "${IMAGE_VERSION}" == "alpha" ]]; then
                    API_VERSION=$(/opt/podverse-ops/scripts/ghcr/getLatestAlphaTag.sh)
                    if [[ -z "${API_VERSION}" ]]; then
                        echo "ERROR: No alpha tag found from getLatestAlphaTag.sh" >&2
                        exit 1
                    fi
                    else
                    API_VERSION="${IMAGE_VERSION}"
                    fi

                    echo "Using API_VERSION=${API_VERSION}"

                    sed "s/REPLACE_WITH_API_VERSION/${API_VERSION}/g" docker-compose.yml.template > docker-compose.yml

                    popd
                """
            }
        }
        stage('Make Script') {
            steps {
                sh """#!/usr/bin/env bash
                    set -e
                    pushd /opt/podverse-ops
                    make alpha_api_up
                    popd
                """
            }
        }
    }
}