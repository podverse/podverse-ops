pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Reset Alpha DB Schema') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops'
                    dir('/opt/podverse-ops') {
                        // Maps to the docker exec command.
                        // We use single quotes for the sh step so the double quotes 
                        // inside the command are preserved for bash.
                        sh 'docker exec podverse_alpha_db psql -U postgres -d postgres -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"'
                    }
                }
            }
        }
    }
}