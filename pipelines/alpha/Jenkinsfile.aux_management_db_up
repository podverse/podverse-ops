pipeline {
    agent {
        label 'pv-alpha-aux'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Start Alpha Management Database') {
            steps {
                script {
                    dir('/opt/podverse-ops') {
                        sh 'make alpha_management_db_up'
                    }
                }
            }
        }
    }
}
