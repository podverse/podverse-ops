pipeline {
    // Maps to <assignedNode>pv-alpha-srv</assignedNode>
    agent {
        label 'pv-alpha-srv'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Remove Docker Network') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops'
                    dir('/opt/podverse-ops') {
                        // Maps to 'docker network rm podverse_alpha_network'
                        // This will fail if the network does not exist (matching 'set -e' behavior).
                        sh 'docker network rm podverse_alpha_network'
                    }
                }
            }
        }
    }
}