pipeline {
    agent {
        label 'pv-alpha-srv'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        string(
            name: 'IMAGE_VERSION',
            defaultValue: 'alpha',
            description: 'Docker image version to deploy (default: alpha = latest alpha tag)'
        )
        string(
            name: 'GIT_BRANCH_NAME',
            defaultValue: 'v5-develop',
            description: 'Git branch to checkout and pull for ops repo'
        )
    }

    stages {
        // Database reset steps
        stage('1. DB Reset (aux db)') {
            steps {
                build job: 'pipelines/alpha/aux_db_reset', wait: true, propagate: true
            }
        }

        stage('1a. DB Reset (management db)') {
            steps {
                build job: 'pipelines/alpha/aux_management_db_reset', wait: true, propagate: true
            }
        }

        stage('2. Stop DB (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_db_down', wait: true, propagate: true
            }
        }

        stage('3. Start DB (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_db_up', wait: true, propagate: true
            }
        }

        stage('4. Init DB (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_db_init', wait: true, propagate: true
            }
        }

        // Standard deploy steps
        stage('5. Stop Workers (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_down', wait: true, propagate: true
            }
        }

        stage('6. Prune Images (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_docker_prune_images', wait: true, propagate: true
            }
        }

        stage('7. Stop Management Web (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_management_web_down', wait: true, propagate: true
            }
        }

        stage('8. Stop Management API (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_management_api_down', wait: true, propagate: true
            }
        }

        stage('9. Stop Web (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_web_down', wait: true, propagate: true
            }
        }

        stage('10. Stop API (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_api_down', wait: true, propagate: true
            }
        }

        stage('11. Prune Images (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_docker_prune_images', wait: true, propagate: true
            }
        }

        stage('12. Git Pull (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_ops_git_pull',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'GIT_BRANCH_NAME', value: params.GIT_BRANCH_NAME)
                      ]
            }
        }

        stage('13. Git Pull (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_ops_git_pull',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'GIT_BRANCH_NAME', value: params.GIT_BRANCH_NAME)
                      ]
            }
        }

        stage('14. Pull Workers (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_pull', wait: true, propagate: true
            }
        }

        stage('15. Start Parsers (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_mq_rss_run_parsers_all', wait: true, propagate: true
            }
        }

        stage('16. Start Live Item Listener (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_mq_rss_run_live_item_listener', wait: true, propagate: true
            }
        }

        stage('17. Start DLQ Consumer (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_mq_rss_run_dlq_consumer', wait: true, propagate: true
            }
        }

        stage('18. Start API (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_api_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }

        stage('19. Start Management API (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_management_api_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }

        stage('20. Start Web (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_web_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }

        stage('21. Start Management Web (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_management_web_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }
    }

    post {
        success {
            echo '✅ Alpha DB reset and deployment completed successfully!'
        }
        failure {
            echo '❌ Alpha DB reset and deployment failed! Check the failed stage above.'
        }
        always {
            echo "Deployment finished at: ${new Date()}"
        }
    }
}
