pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    // Maps to <hudson.triggers.TimerTrigger>
    // Runs roughly at 6 AM and 6 PM daily
    triggers {
        cron('H 6,18 * * *')
    }

    stages {
        stage('Run Worker Archive') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops/docker-compose/alpha/workers'
                    dir('/opt/podverse-ops/docker-compose/alpha/workers') {
                        // Maps to the docker compose run command.
                        // We use 'set -ux' to match the XML (verbose output + unset variable checking).
                        // Jenkins sh implies 'set -e' automatically.
                        sh '''
                            set -ux
                            # Proceed if any podverse-workers image is available (local or GHCR)
                            if docker image ls --format '{{.Repository}}:{{.Tag}}' | grep -E '(^|/)podverse-workers(:|/)|(^|/)podverse_alpha_workers(:|$)'; then
                                docker compose -f docker-compose.yml run --rm podverse_alpha_workers npm run archive_all
                            else
                                echo "No podverse-workers image found locally. Marking build NOT_BUILT and skipping."
                                exit 0
                            fi
                        '''
                        // Mark build as NOT_BUILT when image is missing
                        script {
                            def hasImage = sh(script: "docker image ls --format '{{.Repository}}:{{.Tag}}' | grep -E '(^|/)podverse-workers(:|/)|(^|/)podverse_alpha_workers(:|\\$)' >/dev/null 2>&1", returnStatus: true) == 0
                            if (!hasImage) {
                                currentBuild.result = 'NOT_BUILT'
                            }
                        }
                    }
                }
            }
        }
    }
}