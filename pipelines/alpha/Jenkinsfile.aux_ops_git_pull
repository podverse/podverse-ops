pipeline {
    agent {
        label 'pv-alpha-aux'
    }

    parameters {
        string(name: 'GIT_BRANCH_NAME', defaultValue: 'v5-develop', description: 'Branch to build')
    }

    stages {
        stage('Run Script') {
            steps {
                sh """#!/usr/bin/env bash
                    set -e
                    
                    echo "Running on branch: ${params.GIT_BRANCH_NAME}"

                    # Ensure the directory exists before pushing
                    if [ -d "/opt/podverse-ops" ]; then
                        pushd /opt/podverse-ops
                        
                        # Fetch latest refs to ensure the branch exists locally
                        git fetch origin

                        git checkout ${params.GIT_BRANCH_NAME}

                        git pull origin ${params.GIT_BRANCH_NAME}

                        popd
                    else
                        echo "Error: /opt/podverse-ops directory not found on this node."
                        exit 1
                    fi
                """
            }
        }
    }
}