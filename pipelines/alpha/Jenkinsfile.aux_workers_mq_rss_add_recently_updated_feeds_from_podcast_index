pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    triggers {
        cron('H/5 * * * *')
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        choice(
            name: 'MQ_QUEUE_NAME', 
            choices: ['rss-normal', 'rss-slow', 'rss-on-demand', 'rss-live'],
            description: 'The mq queue which the feeds should be added to for parsing.'
        )
        
        string(
            name: 'SINCE_RANGE', 
            defaultValue: '900', 
            description: 'The value in seconds of the range of historical data you want to request from Podcast Index. Example: 900 = 15 minutes.'
        )
    }

    stages {
        stage('Add Recent Feeds to Queue') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse-ops/docker-compose/alpha/workers'
                    dir('/opt/podverse-ops/docker-compose/alpha/workers') {
                        // Maps to the shell command logic.
                        // We use triple double-quotes (""") to allow Groovy interpolation of ${params}.
                        // Avoid "$()" subshell syntax inside Groovy GString to prevent Jenkins parsing errors.
                        // Compute any derived names in Groovy, then interpolate directly.
                        def mqQueueNameUnderscore = params.MQ_QUEUE_NAME.toLowerCase().replace('-', '_')
                        def containerName = "podverse_alpha_workers_mq_rss_add_recently_updated_feeds_from_podcast_index"

                        sh """
                            set -eux

                            # Using names computed in Groovy to avoid shell subshells in GString
                            CONTAINER_NAME="${containerName}"
                            MQ_QUEUE_NAME_UNDERSCORE="${mqQueueNameUnderscore}"

                            # Check for any available podverse-workers image (local or GHCR) and proceed if present
                            if docker image ls --format '{{.Repository}}:{{.Tag}}' | grep -E '(^|/)podverse-workers(:|/)|(^|/)podverse_alpha_workers(:|\$)'; then
                                docker compose -f docker-compose.yml run --rm --name "${containerName}" podverse_alpha_workers npm run mq_rss_add_recently_updated_feeds_from_podcast_index -- -q "${params.MQ_QUEUE_NAME}" -sr "${params.SINCE_RANGE}"
                            else
                                echo "No podverse-workers image found locally. Marking build NOT_BUILT and skipping."
                                exit 0
                            fi
                        """
                        script {
                            def hasImage = sh(script: "docker image ls --format '{{.Repository}}:{{.Tag}}' | grep -E '(^|/)podverse-workers(:|/)|(^|/)podverse_alpha_workers(:|\\$)' >/dev/null 2>&1", returnStatus: true) == 0
                            if (!hasImage) {
                                currentBuild.result = 'NOT_BUILT'
                            }
                        }
                    }
                }
            }
        }
    }
}